        "html": "<section id=\"servicios\" data-lz-slot=\"services\" data-lz-variant=\"glass-card-grid\" class=\"lz-section lz-services-glass-card-grid\">\n  <div class=\"lz-container\">\n    <p class=\"lz-services-glass-card-grid__kicker\" data-lz-key=\"kicker\"></p>\n    <h2 class=\"lz-title lz-title--section\" data-lz-key=\"title\"></h2>\n    <div class=\"lz-services-glass-card-grid__grid\">\n      <article class=\"lz-services-glass-card-grid__card\" data-lz-each=\"prices\">\n        <p class=\"lz-services-glass-card-grid__price\" data-lz-key=\"price\"></p>\n        <h3 class=\"lz-services-glass-card-grid__name\" data-lz-key=\"name\"></h3>\n        <p class=\"lz-services-glass-card-grid__desc\" data-lz-key=\"description\"></p>\n      </article>\n    </div>\n  </div>\n</section>\n",
        "css": ".lz-services-glass-card-grid {\n  padding: var(--lz-section-pad) 0;\n}\n\n.lz-services-glass-card-grid__kicker {\n  margin: 0 0 calc(12px * var(--lz-space));\n  color: var(--lz-color-text);\n  font-size: calc(14px * var(--lz-text-scale));\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n}\n\n.lz-services-glass-card-grid__grid {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: calc(20px * var(--lz-space));\n  margin-top: calc(40px * var(--lz-space));\n}\n\n.lz-services-glass-card-grid__card {\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n  gap: calc(14px * var(--lz-space));\n  min-height: calc(220px * var(--lz-space));\n  padding: calc(32px * var(--lz-space));\n  border-radius: var(--lz-radius-card);\n  color: var(--lz-color-text);\n  background: color-mix(in srgb, var(--lz-color-text) 6%, transparent);\n  border: 1px solid color-mix(in srgb, var(--lz-color-text) 14%, transparent);\n  -webkit-backdrop-filter: blur(20px);\n  backdrop-filter: blur(20px);\n}\n\n.lz-services-glass-card-grid__price {\n  margin: 0;\n  color: var(--lz-color-accent-text);\n  font-family: var(--lz-font-display);\n  font-size: calc(clamp(36px, 4.4vw, 60px) * var(--lz-display-scale));\n  letter-spacing: var(--lz-display-tracking, 0);\n  line-height: 1;\n}\n\n.lz-services-glass-card-grid__name {\n  margin: 0;\n  font-family: var(--lz-font-display);\n  font-size: calc(24px * var(--lz-text-scale));\n  line-height: 1.2;\n}\n\n.lz-services-glass-card-grid__desc {\n  max-width: 44ch;\n  margin: 0;\n  color: var(--lz-color-muted);\n  font-size: calc(16px * var(--lz-text-scale));\n  line-height: 1.55;\n  text-wrap: pretty;\n}\n\n@media (max-width: 992px) {\n  .lz-services-glass-card-grid__grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n  .lz-services-glass-card-grid__card,\n  .lz-services-glass-card-grid__card:nth-child(n) {\n    grid-column: auto;\n  }\n}\n\n@media (max-width: 480px) {\n  .lz-services-glass-card-grid__grid {\n    grid-template-columns: minmax(0, 1fr);\n  }\n  .lz-services-glass-card-grid__card,\n  .lz-services-glass-card-grid__card:nth-child(n) {\n    grid-column: auto;\n    padding: calc(24px * var(--lz-space));\n  }\n}\n",
        "meta_ts": "import type { SectionMeta } from '../../../src/types';\n\n// Stitch: restaurante-casa-rosa-mantequilla-patisserie-artisan-01\nexport default {\n  slot: \"services\",\n  variant: \"glass-card-grid\",\n  label: \"Servicios y precios\",\n  region: 'main',\n  description: \"Tarjetas de cristal (translúcidas con borde fino) con el precio grande arriba, nombre y descripción; tres por fila en escritorio.\",\n  numbered: true,\n  tiers: [\n  \"basic\",\n  \"pro\"\n],\n  intent: \"Catálogo en retícula con tarjetas de cristal (translúcidas con borde fino), a partir de un patrón de Stitch; para giros con pocos servicios bien diferenciados.\",\n  archetypes: [\n  \"catalog\",\n  \"soft\"\n],\n  contentKeys: [\n  \"kicker\",\n  \"title\",\n  \"prices[].name\",\n  \"prices[].price\",\n  \"prices[].description\"\n],\n  sample: {\n  \"prices\": [\n    {\n      \"name\": \"Valoración inicial\",\n      \"price\": \"$600\",\n      \"description\": \"Revisión completa y plan por escrito, sin compromiso.\"\n    },\n    {\n      \"name\": \"Limpieza profunda\",\n      \"price\": \"$950\",\n      \"description\": \"Higiene con ultrasonido y pulido, en una sola visita.\"\n    },\n    {\n      \"name\": \"Blanqueamiento\",\n      \"price\": \"$3,200\",\n      \"description\": \"Dos sesiones con seguimiento de sensibilidad.\"\n    },\n    {\n      \"name\": \"Ortodoncia\",\n      \"price\": \"$1,400\",\n      \"description\": \"Mensualidad con revisión incluida.\"\n    }\n  ]\n},\n} satisfies SectionMeta;\n",
