              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          }
        },
        "summary": "Service health (public)",
        "tags": [
          "health"
        ]
      }
    },
    "/me": {
      "get": {
        "operationId": "MeController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Current user (protected — requires Supabase JWT)",
        "tags": [
          "me"
        ]
      },
      "delete": {
        "operationId": "MeController_deleteMe",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Account deleted."
          },
          "401": {
            "description": "Missing or invalid bearer token."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Delete current account (protected — requires Supabase JWT)",
        "tags": [
          "me"
        ]
      }
    },
    "/sites/{tenantId}/schema": {
      "get": {
        "operationId": "SitesController_getSchema",
        "parameters": [
          {
            "name": "tenantId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteSchemaResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token."
          },
          "403": {
            "description": "Tenant does not belong to the caller."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Load the tenant site editor project (protected)",
        "tags": [
          "sites"
        ]
      },
      "patch": {
        "operationId": "SitesController_saveSchema",
        "parameters": [
          {
            "name": "tenantId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveSchemaDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SaveSchemaResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token."
          },
          "403": {
            "description": "Tenant does not belong to the caller."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Autosave the tenant site editor project (protected)",
        "tags": [
          "sites"
        ]
      }
    },
    "/sites/{tenantId}/publish": {
      "post": {
        "operationId": "SitesController_publish",
        "parameters": [
          {
            "name": "tenantId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublishSiteDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishSiteResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token."
          },
          "403": {
            "description": "Tenant does not belong to the caller."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Publish the tenant site (protected)",
        "tags": [
          "sites"
        ]
      }
    },
    "/sites/select-template": {
      "post": {
        "operationId": "SitesController_selectTemplate",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectTemplateDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SelectTemplateResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token."
          },
          "404": {
            "description": "No tenant for this user, or template not found."
          },
          "409": {
            "description": "Site schema already exists for this tenant."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Select a template for the caller tenant (protected)",
        "tags": [
          "sites"
        ]
      }
    },
    "/sites/{tenantId}/template": {
      "patch": {
        "operationId": "SitesController_changeTemplate",
        "parameters": [
          {
            "name": "tenantId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeTemplateDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangeTemplateResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token."
          },
          "403": {
            "description": "Tenant does not belong to the caller."
          },
          "404": {
            "description": "No site schema found, or template not found."
          },
          "409": {
            "description": "Confirmation required to reset existing site content."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Change the template for the tenant site (protected)",
        "tags": [
          "sites"
        ]
      }
    },
    "/templates": {
      "get": {
        "operationId": "TemplatesController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TemplateListItemDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List active templates (protected)",
        "tags": [
          "templates"
        ]
      }
    },
    "/tenants/me": {
      "get": {
        "operationId": "TenantsController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantMeResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token."
          },
          "404": {
            "description": "No tenant exists for this user."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get the authenticated user tenant (protected)",
        "tags": [
          "tenants"
        ]
      }
    }
  },
  "info": {
    "title": "Lattiz API",
    "description": "Lattiz resource server. Auth is handled by Supabase; this API only validates Supabase-issued JWTs (JWKS / ES256, audience `authenticated`).",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Supabase access token (JWT)."
      }
    },
    "schemas": {
      "DependencyStatusDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "mock",
            "description": "Dependency name."
          },
          "status": {
            "enum": [
              "up",
              "down"
            ],
            "type": "string",
            "example": "up"
          }
        },
        "required": [
          "name",
          "status"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "type": "string",
            "example": "ok",
            "description": "Overall service status."
          },
          "dependencies": {
            "description": "Per-dependency probe results.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DependencyStatusDto"
            }
          }
        },
        "required": [
          "status",
          "dependencies"
        ]
      },
      "UserProfileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Profile id (matches the Supabase user id)."
          },
          "displayName": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "displayName"
        ]
      },
      "MeResponseDto": {
        "type": "object",
        "properties": {
          "sub": {
            "type": "string",
            "description": "Supabase user id (the `sub` claim of the verified JWT)."
          },
          "email": {
            "type": "string",
            "nullable": true,
            "description": "Email claim, when present in the token."
          },
          "claims": {
            "type": "object",
            "additionalProperties": true,
            "description": "The full set of verified JWT claims."
          },
          "profile": {
            "nullable": true,
            "description": "Application profile, or null if none exists yet.",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/UserProfileDto"
              }
            ]
          }
        },
        "required": [
          "sub",
          "email",
          "claims",
          "profile"
        ]
      },
      "SiteSchemaResponseDto": {
        "type": "object",
        "properties": {
          "project": {
            "type": "object",
            "description": "The GrapesJS project JSON to load into the editor (`storage.project`).",
            "additionalProperties": true
          }
        },
        "required": [
          "project"
        ]
      },
      "SaveSchemaDto": {
        "type": "object",
        "properties": {
          "project": {
            "type": "object",
            "description": "The full GrapesJS project JSON (editor state) to persist.",
            "additionalProperties": true
          }
        },
        "required": [
          "project"
        ]
      },
      "SaveSchemaResponseDto": {
        "type": "object",
        "properties": {
          "saved": {
            "type": "boolean"
          },
          "updatedAt": {
            "type": "string",
            "description": "ISO timestamp of the persisted change."
          }
        },
        "required": [
          "saved",
          "updatedAt"
        ]
      },
      "PublishSiteDto": {
        "type": "object",
        "properties": {
          "project": {
            "type": "object",
            "description": "The GrapesJS project JSON (editor state) at publish time.",
            "additionalProperties": true
          },
          "exportedHtml": {
            "type": "string",
            "description": "HTML generated by the `studio:projectFiles` command."
          }
        },
        "required": [
          "project",
          "exportedHtml"
        ]
      },
      "PublishSiteResponseDto": {
        "type": "object",
        "properties": {
          "published": {
            "type": "boolean"
          },
          "publishedAt": {
            "type": "string",
            "description": "ISO timestamp the site was published."
          }
        },
        "required": [
          "published",
          "publishedAt"
        ]
      },
      "SelectTemplateDto": {
        "type": "object",
        "properties": {
          "templateId": {
            "type": "string",
            "description": "Id of the template to seed the tenant's site from."
          }
        },
        "required": [
          "templateId"
        ]
      },
      "SelectTemplateResponseDto": {
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string"
          },
          "templateId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "description": "ISO timestamp the site schema was created."
          }
        },
        "required": [
          "tenantId",
          "templateId",
          "createdAt"
        ]
      },
      "ChangeTemplateDto": {
        "type": "object",
        "properties": {
          "templateId": {
            "type": "string",
            "description": "Id of the template to switch the tenant's site to."
          },
          "confirm": {
            "type": "boolean",
            "description": "Must be true when the site already has content, to acknowledge the reset."
          }
        },
        "required": [
          "templateId"
        ]
      },
      "ChangeTemplateResponseDto": {
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string"
          },
          "templateId": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "description": "ISO timestamp of the persisted change."
          }
        },
        "required": [
          "tenantId",
          "templateId",
          "updatedAt"
        ]
      },
      "TemplateListItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "category": {
            "type": "string",
            "nullable": true
          },
          "previewUrl": {
            "type": "string",
            "nullable": true
          },
          "thumbnailUrl": {
            "type": "string",
            "nullable": true
          },
          "sortOrder": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "category",
          "previewUrl",
          "thumbnailUrl",
          "sortOrder"
        ]
      },
      "TenantSiteMetaDto": {
        "type": "object",
        "properties": {
          "templateId": {
            "type": "string",
            "nullable": true
          },
          "templateName": {
            "type": "string",
            "nullable": true
          },
          "siteStatus": {
            "nullable": true,
            "enum": [
              "draft",
              "published"
            ],
            "type": "string"
          },
          "lastPublishedAt": {
            "type": "string",
            "nullable": true
          },
          "updatedAt": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "templateId",
          "templateName",
          "siteStatus",
          "lastPublishedAt",
          "updatedAt"
        ]
      },
      "TenantMeResponseDto": {
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string",
            "description": "`tenants.id` — the id expected by the editor route (`/editor/:tenantId`)."
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "plan": {
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "inactive",
              "cancelled"
            ],
            "type": "string"
          },
          "domain": {
            "type": "string",
            "nullable": true
          },
          "vercelDomainMapped": {
            "type": "boolean"
          },
          "site": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/TenantSiteMetaDto"
              }
            ]
          }
        },
        "required": [
          "tenantId",
          "slug",
          "name",
          "plan",
          "status",
          "domain",
          "vercelDomainMapped",
          "site"
        ]
      }
    }
  }
}
