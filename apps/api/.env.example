# Supabase project URL, e.g. https://abcdefghijklmno.supabase.co
SUPABASE_URL=

# Optional. If unset, it is derived from SUPABASE_URL as
# ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# Supabase service_role key. API-ONLY — NEVER expose to the frontend/bundle.
# Used for the two privileged paths: account deletion (DELETE /me) and editor
# asset uploads to Storage (POST /sites/:tenantId/assets). The API boots
# without it; those two routes fail until it is set.
SUPABASE_SERVICE_ROLE_KEY=

# REQUIRED. Postgres connection string (Supabase Session Pooler). The API
# fails to start without it. See SETUP.md for where to copy it from.
DATABASE_URL=

# HTTP port the API listens on.
PORT=3000

# Base URL of the web app (@lattiz/web), used for Stripe Checkout success/cancel
# and billing-portal return URLs. Local dev: http://localhost:5173.
APP_URL=http://localhost:5173

# Stripe secret key (test: sk_test_...). The API boots without it, but any
# billing call fails with 401 until it is set.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (whsec_...). Required to verify POST
# /billing/webhooks. For local dev, copy the value printed by
# `stripe listen --forward-to localhost:3000/billing/webhooks`.
STRIPE_WEBHOOK_SECRET=

# Optional. Stripe API version pin; defaults to 2025-06-30.basil if unset.
STRIPE_API_VERSION=2025-06-30.basil

# Comma-separated list of allowed origins for CORS. Only used in production
# (NODE_ENV=production); in development any origin is reflected. If unset in
# production, cross-origin requests are rejected.
CORS_ORIGIN=

# ── GoDaddy API ──────────────────────────────────────────────────────────
# Personal Access Token with scopes: domains.domain:read,
# domains.registration:write, domains.dns:update.
# Create at: https://developer.godaddy.com/keys
GODADDY_PAT=

# Production: https://api.godaddy.com — OTE (test, limited): https://api.ote-godaddy.com
GODADDY_BASE_URL=https://api.godaddy.com

# When true: POST /v3/domains/registrations returns a mock response (no charge,
# no real domain). Search and quote ALWAYS call GoDaddy for real prices.
# Set false in production — never commit true.
GODADDY_MOCK_PURCHASES=true

# Maximum domain cost Lattiz absorbs in the plan (USD cents).
# $20.00 USD covers .com, .com.mx, .net, .org.
DOMAIN_MAX_COST_USD_CENTS=2000

# ── Vercel Domains API ───────────────────────────────────────────────────
# Token + project id of the shared tenant-sites Vercel deployment; purchased
# domains are attached to this project (triggers automatic SSL provisioning).
VERCEL_TOKEN=
VERCEL_PROJECT_ID=

# Base URL of the tenant-sites Next.js app, called to purge its cache after a
# publish. Local dev: http://localhost:3002. If unset, revalidation is skipped.
TENANT_SITES_URL=http://localhost:3002

# Shared secret for the tenant-sites POST /api/revalidate call.
# Must match REVALIDATION_SECRET in apps/tenant-sites/.env.local.
REVALIDATION_SECRET=
