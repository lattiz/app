# Supabase project URL, e.g. https://abcdefghijklmno.supabase.co
SUPABASE_URL=

# Optional. If unset, it is derived from SUPABASE_URL as
# ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# Placeholder for the future ORM adapter. NOT used in this session
# (data access goes through an in-memory mock behind the repository port).
DATABASE_URL=

# HTTP port the API listens on.
PORT=3000
