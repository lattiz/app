# Supabase project URL, e.g. https://abcdefghijklmno.supabase.co
SUPABASE_URL=

# Optional. If unset, it is derived from SUPABASE_URL as
# ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# Supabase service_role key. API-ONLY — NEVER expose to the frontend/bundle.
# Used solely for the privileged account-deletion path (DELETE /me). The API
# boots without it; it is only required when an account is actually deleted.
SUPABASE_SERVICE_ROLE_KEY=

# REQUIRED. Postgres connection string (Supabase Session Pooler). The API
# fails to start without it. See SETUP.md for where to copy it from.
DATABASE_URL=

# HTTP port the API listens on.
PORT=3000

# Comma-separated list of allowed origins for CORS. Only used in production
# (NODE_ENV=production); in development any origin is reflected. If unset in
# production, cross-origin requests are rejected.
CORS_ORIGIN=

# Base URL of the tenant-sites Next.js app, called to purge its cache after a
# publish. Local dev: http://localhost:3002. If unset, revalidation is skipped.
TENANT_SITES_URL=http://localhost:3002

# Shared secret for the tenant-sites POST /api/revalidate call.
# Must match REVALIDATION_SECRET in apps/tenant-sites/.env.local.
REVALIDATION_SECRET=
