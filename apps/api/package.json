{
  "name": "@lattiz/api",
  "version": "0.0.0",
  "private": true,
  "description": "Lattiz API — NestJS resource server (hexagonal)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm run test:jest && pnpm run test:node",
    "test:jest": "jest",
    "test:node": "node --import tsx --test \"src/**/*.test.ts\"",
    "generate:openapi": "nest build && node dist/generate-openapi.js",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@google-analytics/admin": "^10.1.1",
    "@google-analytics/data": "^7.2.1",
    "@nestjs/common": "^11.0.13",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.13",
    "@nestjs/platform-express": "^11.0.13",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^11.0.6",
    "@nestjs/throttler": "^6.7.1",
    "@supabase/supabase-js": "^2.108.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "drizzle-orm": "^0.45.2",
    "jose": "^5.10.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.18.0",
    "stripe": "^22.3.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "^0.31.10",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.0",
    "typescript": "^5.8.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "clearMocks": true
  }
}
