# Supabase project URL (used by the browser auth client).
VITE_SUPABASE_URL=https://xxxx.supabase.co

# Supabase anon/publishable key. Safe to expose to the client.
VITE_SUPABASE_ANON_KEY=

# Base URL of the NestJS API (@lattiz/api).
VITE_API_BASE_URL=http://localhost:3000

# Optional: force a mocked dashboard state in local dev
# (active | no-template | no-subscription | loading). Use 'live' to turn
# simulation off and render from the real /tenants/me API with no overrides.
VITE_SIMULATE_DASHBOARD=

# GrapesJS Studio SDK license key. Any value works on localhost;
# a real key is required on non-localhost domains.
VITE_GRAPESJS_LICENSE_KEY=DEV_LICENSE_KEY
