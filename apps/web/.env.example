# Supabase project URL, e.g. https://abcdefghijklmno.supabase.co
VITE_SUPABASE_URL=

# Supabase anon / publishable key. PUBLIC key only.
# NEVER put the service_role key here or anywhere in the web bundle.
VITE_SUPABASE_ANON_KEY=

# Base URL of the Lattiz API (NestJS).
VITE_API_BASE_URL=http://localhost:3000
