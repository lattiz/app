 Discovery and strategy usually take 1–2 weeks. MVP builds range from 4–8 weeks, while full-scale integrations can take 8–12+ weeks depending on data readiness, compliance requirements, and integration complexity.\n    "}]}]}]},{"type":"accordion","classes":["gjs-plg-accordion","faq-item"],"attributes":{"data-type-role":"accordion","open":false,"id":"i48y1i"},"components":[{"tagName":"summary","name":"FAQ Header","classes":["gjs-plg-accordion-header","faq-header"],"attributes":{"id":"itqqjn"},"components":[{"type":"text","name":"FAQ Question","classes":["faq-question"],"attributes":{"id":"i5g33a"},"components":[{"type":"textnode","content":"Do I need technical knowledge to work with your agency ?"}]},{"name":"FAQ Marker","classes":["gjs-plg-accordion-marker","faq-marker"],"attributes":{"id":"ijs545"},"components":[{"type":"image","resizable":{"ratioDefault":1},"attributes":{"src":"https://api.iconify.design/lucide-chevron-down.svg?color=%23FFFFFF","alt":"Expand","width":"24","height":"24"}}]}]},{"name":"FAQ Content","classes":["gjs-plg-accordion-content","faq-content"],"attributes":{"id":"ij2nq6"},"components":[{"type":"text","name":"FAQ Answer","attributes":{"id":"isx2k3"},"components":[{"type":"textnode","content":"Almost any business can benefit from AI—especially those in e-commerce, finance, healthcare, logistics, and customer service. If you have repetitive tasks"}]}]}]},{"type":"accordion","classes":["gjs-plg-accordion","faq-item"],"attributes":{"data-type-role":"accordion","open":false,"id":"i48y1i-2"},"components":[{"tagName":"summary","name":"FAQ Header","classes":["gjs-plg-accordion-header","faq-header"],"attributes":{"id":"itqqjn-2"},"components":[{"type":"text","name":"FAQ Question","classes":["faq-question"],"attributes":{"id":"i5g33a-2"},"components":[{"type":"textnode","content":"Is my data secure and private?"}]},{"name":"FAQ Marker","classes":["gjs-plg-accordion-marker","faq-marker"],"attributes":{"id":"ijs545-2"},"components":[{"type":"image","res