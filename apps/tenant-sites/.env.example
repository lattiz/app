# Supabase (anon/publishable key only — never the service role in this app).
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...

# Shared secret with @lattiz/api for POST /api/revalidate.
# Must match REVALIDATION_SECRET in apps/api/.env.
REVALIDATION_SECRET=

# Development: override the hostname used for tenant resolution. Set it to a
# value stored in tenants.domain for your test tenant (e.g. 'localhost').
TENANT_DEV_HOSTNAME=

# Base domain of the free `{slug}.<base>` addresses. Production: lattiz.app. Local dev:
# localhost:3002 (open http://my-slug.localhost:3002). Must equal PREVIEW_BASE_DOMAIN in apps/api.
PREVIEW_BASE_DOMAIN=lattiz.app

# La ventana de prueba vive en la tabla app_settings de la BD (preview.trial_days / preview.enabled).
# Strict CSP plus the preview banner on sites that have not paid. Paid sites are unchanged.
PREVIEW_HARDEN_ENABLED=true
PREVIEW_ABUSE_REPORT_URL=mailto:soporte@lattiz.app
PREVIEW_UPGRADE_URL=https://dashboard.lattiz.app/dashboard/subscription
