# Supabase (anon/publishable key only — never the service role in this app).
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...

# Shared secret with @lattiz/api for POST /api/revalidate.
# Must match REVALIDATION_SECRET in apps/api/.env.
REVALIDATION_SECRET=

# Development: override the hostname used for tenant resolution. Set it to a
# value stored in tenants.domain for your test tenant (e.g. 'localhost').
TENANT_DEV_HOSTNAME=
