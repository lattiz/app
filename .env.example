# Root env — used by scripts/parse-and-seed-template.ts and scripts/setup-template-previews.ts.
# Per-app env lives in apps/api/.env and apps/web/.env (see their .env.example).
# The seed script reads ./.env first and falls back to apps/api/.env for the shared
# keys below, so with a working API env only TEMPLATE_PREVIEWS_BASE_URL is new.

# Supabase project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=https://xxxx.supabase.co

# Supabase service_role key. Server/ops only — NEVER commit or expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (same values as apps/api/.env). Template assets go to templates/<id>/<sha256[:16]>.<ext>.
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lattiz-assets
R2_PUBLIC_URL=https://assets.lattiz.app

# Stable production URL of the template-previews Vercel project (custom domain or
# its production alias — never a per-deployment URL). Printed by setup-template-previews.ts.
TEMPLATE_PREVIEWS_BASE_URL=https://templates.lattiz.app

# Optional: Vercel account the template-previews project lives in, and a token
# instead of `vercel login`. Used by both scripts.
VERCEL_SCOPE=
VERCEL_TOKEN=

# Optional, setup script only: custom domain to attach (DNS record printed for Cloudflare).
TEMPLATE_PREVIEWS_DOMAIN=templates.lattiz.app
