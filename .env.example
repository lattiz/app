# Root env — used by scripts/parse-and-seed-template.ts (template seeding).
# Per-app env lives in apps/api/.env and apps/web/.env (see their .env.example).

# Supabase project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=https://xxxx.supabase.co

# Supabase service_role key. Server/ops only — NEVER commit or expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
