"],"components":[{"name":"Review Body","classes":["lz-review__body"],"components":[{"type":"text","name":"Review Stars","classes":["lz-review__stars"],"components":[{"type":"textnode","content":"★★★★★"}]},{"tagName":"p","type":"text","name":"Review Text","classes":["lz-review__text"],"components":[{"type":"textnode","content":"Me dejaron el fade exactamente como lo pedí, limpio y bien conectado. La música, la atención y el ambiente se sienten premium sin volverse mamones. Ya es mi spot fijo."}]},{"tagName":"p","type":"text","name":"Review Meta","classes":["lz-review__meta"],"components":[{"type":"textnode","content":"Luis R. · hace 2 semanas"}]}]}]},{"tagName":"article","name":"Review Card","classes":["lz-review"],"components":[{"name":"Review Body","classes":["lz-review__body"],"components":[{"type":"text","name":"Review Stars","classes":["lz-review__stars"],"components":[{"type":"textnode","content":"★★★★★"}]},{"tagName":"p","type":"text","name":"Review Text","classes":["lz-review__text"],"components":[{"type":"textnode","content":"Reservé por WhatsApp y me atendieron puntual. Dante se rifó con la barba a navaja y la toalla caliente, neta se siente el detalle. Todo muy fino y cero prisa."}]},{"tagName":"p","type":"text","name":"Review Meta","classes":["lz-review__meta"],"components":[{"type":"textnode","content":"Mauricio T. · hace 2 semanas"}]}]}]},{"tagName":"article","name":"Review Card","classes":["lz-review"],"components":[{"name":"Review Body","classes":["lz-review__body"],"components":[{"type":"text","name":"Review Stars","classes":["lz-review__stars"],"components":[{"type":"textnode","content":"★★★★★"}]},{"tagName":"p","type":"text","name":"Review Text","classes":["lz-review__text"],"components":[{"type":"textnode","content":"La vibra del lugar está durísima: luces bajas, trap sonando y barberos con mucha técnica. Kenji me hizo textura y color con asesoría real, no solo por vender. Súper recomendado."}]},{"tagName":"p","type":"text","name":"Review Meta","c