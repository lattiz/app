{
  "name": "@lattiz/template-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Templates as source: section fragments + themes + content packs compiled into GrapesJS projects and previews",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "kit:extract": "tsx src/cli/extract.ts",
    "kit:compile": "tsx src/cli/compile.ts",
    "kit:validate": "tsx src/cli/validate.ts",
    "kit:shoot": "tsx src/cli/shoot.ts",
    "kit:shots": "tsx src/cli/shots.ts",
    "kit:build": "tsx src/cli/build.ts",
    "kit:compare": "tsx src/cli/compare.ts",
    "kit:compare-visual": "tsx src/cli/compare-visual.ts",
    "kit:spec": "tsx src/cli/spec.ts",
    "kit:capacity": "tsx src/cli/capacity.ts",
    "kit:gallery": "tsx src/cli/gallery.ts",
    "kit:snapshot": "tsx src/cli/snapshot.ts write",
    "kit:verify-snapshot": "tsx src/cli/snapshot.ts verify"
  },
  "dependencies": {
    "grapesjs": "0.22.16",
    "jsdom": "^30.1.2",
    "playwright": "^1.63.0",
    "postcss": "^8.5.29",
    "prettier": "^3.8.3",
    "sharp": "^0.35.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capsizecss/core": "4.1.3",
    "@capsizecss/metrics": "4.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.1",
    "tsx": "^4.23.0",
    "typescript": "^5.8.3",
    "vitest": "^5.0.3"
  }
}
