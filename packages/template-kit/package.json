{
  "name": "@lattiz/template-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Templates as source: section fragments + themes + content packs compiled into GrapesJS projects and previews",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "kit:extract": "tsx src/cli/extract.ts",
    "kit:compile": "tsx src/cli/compile.ts",
    "kit:validate": "tsx src/cli/validate.ts",
    "kit:shoot": "tsx src/cli/shoot.ts",
    "kit:build": "tsx src/cli/build.ts",
    "kit:compare": "tsx src/cli/compare.ts"
  },
  "dependencies": {
    "grapesjs": "0.22.16",
    "jsdom": "^30.1.2",
    "playwright": "^1.63.0",
    "postcss": "^8.5.29",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.1",
    "tsx": "^4.23.0",
    "typescript": "^5.8.3",
    "vitest": "^5.0.3"
  }
}
