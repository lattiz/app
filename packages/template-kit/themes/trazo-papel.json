{
  "name": "trazo-papel",
  "label": "Trazo papel",
  "tier": "basic",
  "fontPair": "fraunces+nunito-sans",
  "colors": {
    "bg": "#F7F1E6",
    "surface": "#FFFDF8",
    "surface-2": "#EDE4D2",
    "text": "#1C1A16",
