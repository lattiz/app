{
  "name": "bone-blue",
  "label": "Hueso y cobalto",
  "colors": {
    "bg": "#F3EFE6",
    "surface": "#FBF9F4",
    "surface-2": "#E8E3D7",
    "text": "#14161C",
    "muted": "#5C5850",
    "accent": "#2D5BFF",
    "on-accent": "#FFFFFF",
    "line": "color-mix(in srgb, var(--lz-color-text) 16%, transparent)",
    "line-strong": "color-mix(in srgb, var(--lz-color-text) 34%, transparent)",
    "overlay": "#0E1530",
    "on-overlay": "#F3EFE6",
    "navbar-bg": "color-mix(in srgb, var(--lz-color-bg) 94%, transparent)",
    "ink": "#0E1530"
  },
  "fonts": {
    "display": "'Bebas Neue', sans-serif",
    "serif": "'DM Serif Display', serif",
    "body": "'DM Sans', sans-serif",
    "googleFonts": "family=Bebas+Neue&family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@400;500;700"
  },
  "radius": { "pill": "999px", "card": "6px" },
  "sectionPad": "clamp(72px, 10vw, 140px)",
  "container": "1200px",
  "effects": {
    "mapFilter": "grayscale(1) contrast(1.05)",
    "heroImageFilter": "grayscale(.3) brightness(.62) contrast(1.05)"
  }
}
