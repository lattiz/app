{
  "name": "concreto-brutal",
  "label": "Concreto brutal",
  "tier": "pro",
  "fontPair": "archivo-black+space-grotesk",
  "colors": {
    "bg": "#F1EFE8",
    "surface": "#FFFFFF",
    "surface-2": "#E4E1D8",
    "text": "#0A0A0A",
    "muted": "#46463F",
    "accent": "#C6F135",
    "on-accent": "#0A0A0A",
    "accent-text": "#0A0A0A",
    "line": "#0A0A0A",
    "line-strong": "#0A0A0A",
    "overlay": "#0A0A0A",
    "on-overlay": "#F1EFE8",
    "navbar-bg": "#F1EFE8",
    "ink": "#0A0A0A"
  },
  "fonts": {
    "display": "'Archivo Black', sans-serif",
    "serif": "'Space Mono', monospace",
    "body": "'Space Grotesk', sans-serif",
    "mono": "'Space Mono', monospace",
    "googleFonts": "family=Archivo+Black&family=Space+Grotesk:wght@400;500;700&family=Space+Mono:wght@400;700",
    "displayTransform": "uppercase",
    "displayLeading": "0.92",
    "displayWeight": "400",
    "accentStyle": "normal",
    "accentTransform": "none"
  },
  "shape": { "radiusCard": "0px", "radiusPill": "0px", "border": "3px", "shadow": "hard-offset" },
  "density": "compact",
  "photoTreatment": "duotone",
  "accentWords": "highlight",
  "container": "1280px",
  "effects": {
    "mapFilter": "grayscale(1) contrast(1.25)",
    "heroImageFilter": "grayscale(1) contrast(1.2) brightness(.55)"
  }
}
