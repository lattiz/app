{
  "name": "trazo-solar",
  "label": "Trazo solar",
  "tier": "basic",
  "fontPair": "unbounded+manrope",
  "colors": {
    "bg": "#E8EAEE",
    "surface": "#F7F8FA",
    "surface-2": "#D9DCE3",
